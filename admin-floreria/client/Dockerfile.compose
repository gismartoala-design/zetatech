FROM node:22-alpine AS build

WORKDIR /app/admin-floreria/client

ARG VITE_API_URL=http://localhost:4001/api
ARG VITE_BACKEND_URL=http://localhost:4001/api
ARG VITE_URL_IMG=http://localhost:4001
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}
ENV VITE_URL_IMG=${VITE_URL_IMG}

COPY admin-floreria/client/package*.json ./
RUN npm ci
RUN ln -s /app/admin-floreria/client/node_modules /app/node_modules

COPY admin-floreria/client/ ./
COPY shared/ /app/shared/
RUN npm run build

FROM nginx:stable-alpine AS runner
COPY admin-floreria/client/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/admin-floreria/client/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
