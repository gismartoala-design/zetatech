# Variables para desplegar con docker-compose en un dominio real.
# No pongas secretos en este archivo; úsalo como plantilla privada.

# URL pública desde la que el navegador del administrador llamará al API.
VITE_ADMIN_API_URL=https://api-admin.tu-dominio.com/api
VITE_ADMIN_ASSET_URL=https://api-admin.tu-dominio.com

# Debe coincidir con la URL pública del panel administrador.
# Se configura en admin-floreria/api/.env y se inyecta al contenedor API.
CORS_ORIGIN=https://admin.tu-dominio.com
